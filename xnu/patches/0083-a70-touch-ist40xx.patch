+/* A70 bring-up: pins, IST40xx 32-bit I2C mode, chip id, start scan; then poll. */
+static void
+touch_a70_run(void)
+{
+	printf("SWEET TOUCH: a70 TLMM sda=%#x scl=%#x irq=%#x (cfg %#x/%#x/%#x)\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(A70_PIN_SDA)), touch_rd(st.gpio, TOUCH_GPIO_IO(A70_PIN_SCL)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(A70_PIN_IRQ)), touch_rd(st.gpio, TOUCH_GPIO_CFG(A70_PIN_SDA)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(A70_PIN_SCL)), touch_rd(st.gpio, TOUCH_GPIO_CFG(A70_PIN_IRQ)));
+	touch_gpio(A70_PIN_IRQ, 0, 0, 0, false, false); /* gpio, input, bias-disable */
+	touch_gpio(A70_PIN_SDA, 1, 0, 0, false, false); /* qup01, bias-disable, 2 mA */
+	touch_gpio(A70_PIN_SCL, 1, 0, 0, false, false);
+	touch_wait(10);
+	uint32_t chip = 0;
+	st.probing = true;
+	int e1 = ist_write(IST_I2C_CTRL, IST_I2C_32BIT);
+	touch_wait(2);
+	int e2 = ist_read(IST_CHIPID, &chip, 1);
+	st.probing = false;
+	printf("SWEET TOUCH: ist40xx 32bit err=%d chipid err=%d value=%#x irq=%#x\n",
+	    e1, e2, chip, st.irq_status);
+	if (st.dead || e2 || ((chip >> 16) != 0x4070u && (chip >> 16) != 0x4050u && (chip & 0xffffu) != 0x4070u &&
+	    (chip & 0xffffu) != 0x4050u)) {
+		printf("SWEET TOUCH: ist40xx not confirmed (dead=%d); stopping, no rail vote\n", st.dead);
+		return;
+	}
+	int e3 = ist_write(IST_HIB_CMD, IST_CMD_REGMAP);
+	int e4 = ist_write(IST_HIB_CMD, IST_CMD_FW_START);
+	printf("SWEET TOUCH: ist40xx regmap err=%d start err=%d; polling every 10 ms, %ux%u\n",
+	    e3, e4, A70_W, A70_H);
+	unsigned errors = 0;
+	while (!st.dead) {
+		int err = touch_ist();
+		if (err) {
+			if ((errors++ % 100u) == 0) {
+				printf("SWEET TOUCH: ist report err=%d irq=%#x\n", err, st.irq_status);
+			}
+			if (errors == 10) {
+				touch_report(0, st.x, st.y);
+			}
+		} else {
+			errors = 0;
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+}
