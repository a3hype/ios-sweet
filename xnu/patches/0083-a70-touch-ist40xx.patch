+static uint32_t
+ist_be32(const uint8_t *b)
+{
+	return ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) | ((uint32_t)b[2] << 8) | b[3];
+}
+
+/* IST40xx read: 4-byte big-endian address (STOP_STRETCH, repeated START), then n big-endian words. */
+static int
+ist_read(uint32_t reg, uint32_t *out, unsigned n)
+{
+	uint8_t a[4] = {(uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg};
+	uint8_t buf[128];
+	if (n == 0 || n > 32) {
+		return EINVAL;
+	}
+	int err = touch_msg(IST_ADDR, a, 4, NULL, 0, true);
+	if (!err) {
+		err = touch_msg(IST_ADDR, NULL, 0, buf, n * 4u, false);
+	}
+	for (unsigned i = 0; !err && i < n; ++i) {
+		out[i] = ist_be32(buf + 4u * i);
+	}
+	return err;
+}
+
+/* IST40xx write: address and value, both big-endian, in one 8-byte message. */
+static int
+ist_write(uint32_t reg, uint32_t val)
+{
+	uint8_t b[8] = {(uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		(uint8_t)(val >> 24), (uint8_t)(val >> 16), (uint8_t)(val >> 8), (uint8_t)val};
+	return touch_msg(IST_ADDR, b, 8, NULL, 0, false);
+}
+
+/*
+ * One IST40xx report (Samsung ist40xx_irq_thread): HIB_INTR_MSG bit 11 = touch status, bits 12..15 = record count;
+ * then 2 words per record from HIB_COORD: y[11:0] x[23:12] status[27:24] id[31:28] (1-based); status 1 press,
+ * 2 release, 0/3 ignored. Polled every 10 ms; an unchanged message+records pair is not reported again.
+ */
+static int
+touch_ist(void)
+{
+	uint32_t msg = 0, coord[2 * IST_MAX_FINGERS];
+	int err = ist_read(IST_HIB_INTR_MSG, &msg, 1);
+	if (err) {
+		return err;
+	}
+	if (msg == 0 || msg == 0xffffffffu || msg == IST_MSG_INITIAL || msg == IST_MSG_REC ||
+	    (msg & 0xffffff00u) == 0xe11ce900u || !(msg & 0x800u)) {
+		if (msg != ist_last_msg && msg != 0) {
+			printf("SWEET TOUCH: ist msg %#x (not a touch report)\n", msg);
+		}
+		ist_last_msg = msg;
+		return 0;
+	}
+	unsigned cnt = (msg >> 12) & 0xfu;
+	if (cnt == 0 || cnt > IST_MAX_FINGERS) {
+		ist_last_msg = msg;
+		return 0;
+	}
+	err = ist_read(IST_HIB_COORD_BA, coord, 2u * cnt);
+	if (err) {
+		return err;
+	}
+	if (msg == ist_last_msg) {
+		bool same = true;
+		for (unsigned i = 0; i < 2u * cnt; ++i) {
+			same = same && coord[i] == ist_last_coord[i];
+		}
+		if (same) {
+			return 0;
+		}
+	}
+	ist_last_msg = msg;
+	for (unsigned i = 0; i < 2u * cnt; ++i) {
+		ist_last_coord[i] = coord[i];
+	}
+	uint32_t mask = st.active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	for (unsigned i = 0; i < cnt; ++i) {
+		uint32_t w = coord[2u * i];
+		unsigned status = (w >> 24) & 0xfu, id = (w >> 28) & 0xfu;
+		int fy = (int)(w & 0xfffu), fx = (int)((w >> 12) & 0xfffu);
+		if (id == 0 || id > TOUCH_MAX) {
+			continue;
+		}
+		id -= 1;
+		if (status == 1u && fx < A70_W && fy < A70_H) {
+			mask |= 1u << id;
+			x[id] = fx;
+			y[id] = fy;
+		} else if (status == 2u) {
+			mask &= ~(1u << id);
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
